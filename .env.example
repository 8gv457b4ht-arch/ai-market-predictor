# ===================== AI Market Predictor configuration =====================
# Copy to .env (scripts/start.sh does this and generates API_KEY for you).
# NEVER commit .env: it holds secrets. Only public, key-less exchange data is used.

# ---- Security ---------------------------------------------------------------
# Required to use the dashboard/API. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated origins allowed to call the API from other sites (empty = same origin only)
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=240
# true only when running behind the bundled Caddy / another reverse proxy
TRUST_PROXY_HEADERS=false
# Where the API port is published: 0.0.0.0 = reachable from the internet, 127.0.0.1 = local only
BIND_ADDRESS=0.0.0.0
API_PORT=8000
# Domain for the optional HTTPS profile (docker compose --profile https up -d)
DOMAIN=

# ---- Markets ----------------------------------------------------------------
EXCHANGES=binance,bybit,okx
# Exchange whose candles train the models; the others are used for cross-checks and the order-book view
PRIMARY_EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d
# Timeframes that get their own model (each uses all higher timeframes as context)
PREDICT_TIMEFRAMES=15m,1h
# Prediction horizon in bars of the predicted timeframe
HORIZON_BARS=4
HISTORY_BARS=5000
CONTEXT_HISTORY_BARS=1500
# WebSocket / REST endpoints (override only if an exchange changes them or for regional hosts)
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot
OKX_WS_URL=wss://ws.okx.com/ws/v5/public
BINANCE_REST_URL=https://api.binance.com
BYBIT_REST_URL=https://api.bybit.com
OKX_REST_URL=https://www.okx.com

# ---- Collector & data quality -----------------------------------------------
STALE_AFTER_SEC=30
RECONNECT_MAX_SEC=60
FLUSH_INTERVAL_SEC=1
CANDLE_SYNC_SEC=30
STORE_RAW_TRADES=true
MIN_QUALITY_SCORE=0.70
MAX_SPREAD_BPS=15
MAX_EXCHANGE_DIVERGENCE_BPS=40

# ---- Retention ---------------------------------------------------------------
RAW_TRADES_RETENTION_HOURS=6
BOOK_SAMPLES_RETENTION_DAYS=7
FLOW_BARS_RETENTION_DAYS=30
CANDLES_1M_RETENTION_DAYS=30
NEWS_RETENTION_DAYS=60

# ---- Prediction gating --------------------------------------------------------
# Minimum P(direction) to emit UP/DOWN; below -> NO TRADE
CONFIDENCE_THRESHOLD=0.55
# Minimum |P(UP) - P(DOWN)|
MIN_EDGE=0.10
# A move counts as UP/DOWN only if larger than max(round-trip cost, LABEL_ATR_MULT * ATR% * sqrt(horizon))
LABEL_ATR_MULT=0.30
BLOCK_LOW_LIQUIDITY=true
PREDICTOR_POLL_SEC=10

# ---- Costs used in labels and backtests ---------------------------------------
FEE_BPS=10
SLIPPAGE_BPS=2
SPREAD_BPS=1
LATENCY_MS=500

# ---- Self-learning ------------------------------------------------------------
LEARNING_INTERVAL_SEC=900
# New labelled bars the production model has never seen before a challenger is trained
LEARNING_MIN_NEW_LABELS=300
LEARNING_HOLDOUT_FRACTION=0.5
LEARNING_MIN_HOLDOUT=150
LEARNING_MIN_LOGLOSS_GAIN=0.002
LEARNING_BOOTSTRAP_CONFIDENCE=0.90
WALK_FORWARD_FOLDS=5
MIN_TRAIN_ROWS=600

# ---- News AI --------------------------------------------------------------------
NEWS_INTERVAL_SEC=300
NEWS_HALF_LIFE_MIN=180
# auto | anthropic | openai | none. Without a key the transparent rule-based analyzer is used.
NEWS_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Any OpenAI-compatible chat-completions API; set the model your account has access to
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
NEWS_LLM_MAX_ITEMS=20
# Comma-separated RSS/Atom feeds (defaults are built in; set to override)
# NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# ---- Storage & backups ---------------------------------------------------------
# Default: SQLite in ./data. PostgreSQL: postgresql://user:pass@host:5432/db (+ requirements-postgres.txt)
# DATABASE_URL=
BACKUP_INTERVAL_SEC=21600
BACKUP_KEEP=14

# ---- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Notifications (research alerts, never trading instructions) ----------------
# Events: signals (UP/DOWN), all_predictions, outages, promotions
NOTIFY_EVENTS=signals,outages,promotions
# ntfy.sh: install the ntfy app and subscribe to a long random topic name (no account needed)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Telegram: create a bot with @BotFather, send it a message, use your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Link added to notifications
DASHBOARD_URL=

# ---- Cloud (scheduled GitHub Actions) mode ----------------------------------------
# Seconds of live WebSocket sampling per scheduled run
WS_SAMPLE_SEC=45
# Where the public JSON for the dashboard is written
PUBLIC_DIR=public
