# Optional extra guarantee that the stack is up after boot (Docker restart policies already do this).
# sudo cp deploy/systemd/ai-market-predictor.service /etc/systemd/system/ && sudo systemctl enable --now ai-market-predictor
[Unit]
Description=AI Market Predictor (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-market-predictor
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
